# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก .gitignore ไว้แล้ว ไม่ขึ้น git)
#   cp .env.example .env

# --- PostgreSQL ---
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = security_central
DB_USER = jj
DB_PASSWORD = changeme

# --- Redis (central, mTLS) ---
REDIS_HOST=192.168.56.110
REDIS_PORT=6380
REDIS_SSL=True

# cert/key/ca สำหรับต่อ Redis แบบ mTLS — ออกโดย CA ของโปรเจกต์ (ดู cert/central/)
REDIS_CERT=/home/jj/security_pj/cert/central/central.crt
REDIS_KEY=/home/jj/security_pj/cert/central/central.key
REDIS_CA=/home/jj/security_pj/cert/central/ca.crt

REDIS_USER=admin
REDIS_PASS=changeme

# --- JWT / Cookie (login) ---
# gen ใหม่ได้ด้วย: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_EXPIRE_MIN=500

CSRF_SECRET=changeme-generate-a-random-secret
# true = cookie ส่งเฉพาะผ่าน HTTPS เท่านั้น (ต้องรัน uvicorn แบบ --ssl-certfile/--ssl-keyfile ด้วย — ดู process.md)
COOKIE_SECURE=true

ALGORITHM = HS256

# --- IP ที่แต่ละ service เปิดรับ (systemd/_gen.sh อ่านไปใส่ --host ของ unit) ---
# ปกติไม่ต้องกรอกเอง — sudo systemd/install.sh จะถามให้เลือกจาก interface ที่มีจริงบนเครื่อง
# แล้วเขียนค่าลงที่นี่ให้ (แก้เองก็ได้ แต่ต้องรัน install.sh ใหม่ค่าถึงจะมีผล)
#   0.0.0.0 = ทุก interface · ใส่ IP เดียว = เครือข่ายอื่นของเครื่องเข้าไม่ถึงพอร์ตนั้นเลย
# ⚠️ WEB_BIND_HOST ที่เป็น IP เดียว ต้องมี IP นั้นใน SAN ของ cert/central/dashboard.crt ด้วย
WEB_BIND_HOST=0.0.0.0
# LINE ยิง webhook เข้ามาผ่าน tunnel — tunnel อยู่เครื่องเดียวกันตั้ง 127.0.0.1 ได้ (ไม่โผล่ออกเครือข่าย)
WEBHOOK_BIND_HOST=0.0.0.0

# --- LINE Messaging API (แจ้งเตือน alert) — เอาค่าจาก LINE Developers Console ของ channel ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Gemini (AI สรุป log ใน alert — on-demand, ไม่ตั้งก็ใช้งานส่วนอื่นได้ปกติ) ---
# เอา API key จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=
