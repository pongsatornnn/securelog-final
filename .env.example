# .env.example — ไฟล์อ้างอิงรายการคีย์ ไม่ใช่ไฟล์ที่เอาไปใช้จริง
#
# ปกติไม่ต้องแตะไฟล์นี้เลย: `sudo ./setup-server.sh` สร้าง .env ให้ครบตอนติดตั้ง
# โดยใส่ path/IP ของเครื่องนั้นเอง และสุ่ม JWT_SECRET_KEY / CSRF_SECRET ให้อัตโนมัติ
# (.env ถูก .gitignore ไว้แล้ว ไม่ขึ้น git)
#
# มีไว้ดูว่าคีย์ไหนทำอะไร และไว้เทียบตอนต้องเติมคีย์ที่ขาดใน .env เดิมด้วยมือ
# ค่าที่เป็น <...> ต้องแทนด้วยค่าจริงของเครื่องนั้น — อย่า cp ไฟล์นี้เป็น .env ทั้งไฟล์

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=security_central
DB_USER=<db user>
DB_PASSWORD=<db password>

# --- Redis (central, mTLS) ---
# REDIS_HOST = IP ที่เครื่องอื่นใช้เรียกเข้ามาที่ central (ตัวเดียวกับที่อยู่ใน SAN ของ cert)
REDIS_HOST=<central ip>
REDIS_PORT=6380
REDIS_SSL=True

# cert/key/ca สำหรับต่อ Redis แบบ mTLS — ออกโดย CA ของโปรเจกต์ตอนติดตั้ง (ดู cert/central/)
# ต้องเป็น absolute path ที่ชี้ไปใต้โฟลเดอร์ที่ติดตั้งจริง
REDIS_CERT=<install dir>/cert/central/central.crt
REDIS_KEY=<install dir>/cert/central/central.key
REDIS_CA=<install dir>/cert/central/ca.crt

REDIS_USER=admin
# ต้องตรงกับรหัสของบัญชีเดียวกันใน redis/users.acl ไม่งั้น central ต่อ Redis ไม่ได้
REDIS_PASS=<redis password>

# --- JWT / Cookie (login) ---
# gen ใหม่ได้ด้วย: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=<random secret>
JWT_EXPIRE_MIN=500

CSRF_SECRET=<random secret>
# true = cookie ส่งเฉพาะผ่าน HTTPS เท่านั้น (dashboard รันเป็น HTTPS อยู่แล้ว)
COOKIE_SECURE=true

ALGORITHM=HS256

# --- IP ที่แต่ละ service เปิดรับ (systemd/_gen.sh อ่านไปใส่ --host ของ unit) ---
# ปกติไม่ต้องกรอกเอง — sudo systemd/install.sh จะถามให้เลือกจาก interface ที่มีจริงบนเครื่อง
# แล้วเขียนค่าลงที่นี่ให้ (แก้เองก็ได้ แต่ต้องรัน install.sh ใหม่ค่าถึงจะมีผล)
#   0.0.0.0 = ทุก interface · ใส่ IP เดียว = เครือข่ายอื่นของเครื่องเข้าไม่ถึงพอร์ตนั้นเลย
# ⚠️ WEB_BIND_HOST ที่เป็น IP เดียว ต้องมี IP นั้นใน SAN ของ cert/central/dashboard.crt ด้วย
WEB_BIND_HOST=0.0.0.0
# LINE ยิง webhook เข้ามาผ่าน tunnel — tunnel อยู่เครื่องเดียวกันตั้ง 127.0.0.1 ได้ (ไม่โผล่ออกเครือข่าย)
WEBHOOK_BIND_HOST=0.0.0.0

# --- LINE Messaging API (แจ้งเตือน alert) — เอาค่าจาก LINE Developers Console ของ channel ---
# ตั้งทีหลังได้จากหน้า System Settings ในเว็บ
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Gemini (AI สรุป log ใน alert — on-demand, ไม่ตั้งก็ใช้งานส่วนอื่นได้ปกติ) ---
# เอา API key จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- ค่าที่ถูกฝังลงชุดติดตั้ง agent (แก้ทีหลังได้จากหน้า System Settings) ---
# setup-server.sh เขียนกลุ่มนี้ให้ตอนติดตั้ง · .env เก่าที่ยังไม่มีกลุ่มนี้จะถูกเติมให้อัตโนมัติ
AGENT_CENTRAL_HOST=<central ip>
AGENT_CENTRAL_REDIS_PORT=6380
AGENT_REDIS_USERNAME=agent_node
# ต้องตรงกับรหัสของบัญชี agent_node ใน redis/users.acl ไม่งั้น agent ส่ง log เข้ามาไม่ได้
AGENT_REDIS_PASSWORD=<agent redis password>
