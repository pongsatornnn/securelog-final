# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก .gitignore ไว้แล้ว ไม่ขึ้น git)
#   cp .env.example .env

# --- PostgreSQL ---
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = security_central
DB_USER = jj
DB_PASSWORD = changeme

# --- Redis (central, mTLS) ---
# setup-server.sh ถามทั้งสองค่านี้ตอนติดตั้ง (พอร์ตถามต่อจากที่อยู่) แล้วเขียนลงมาให้
# ⚠️ REDIS_PORT ต้องตรงกับ tls-port ใน redis/redis-mtls.conf — แก้ที่นี่อย่างเดียวไม่พอ
#    ให้รัน setup-server.sh ซ้ำ (มันเขียน redis-mtls.conf ใหม่ + สำรองไฟล์เดิมเป็น .bak
#    + เปิด firewall + restart centralredis ให้ครบในรอบเดียว)
REDIS_HOST=192.168.56.110
REDIS_PORT=6380
REDIS_SSL=True

# cert/key/ca สำหรับต่อ Redis แบบ mTLS — ออกโดย CA ของโปรเจกต์ (ดู cert/central/)
REDIS_CERT=/home/jj/security_pj/cert/central/central.crt
REDIS_KEY=/home/jj/security_pj/cert/central/central.key
REDIS_CA=/home/jj/security_pj/cert/central/ca.crt

REDIS_USER=admin
REDIS_PASS=changeme

# --- JWT / Cookie (login) ---
# gen ใหม่ได้ด้วย: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_EXPIRE_MIN=500

CSRF_SECRET=changeme-generate-a-random-secret
# true = cookie ส่งเฉพาะผ่าน HTTPS เท่านั้น (ต้องรัน uvicorn แบบ --ssl-certfile/--ssl-keyfile ด้วย — ดู process.md)
COOKIE_SECURE=true

ALGORITHM = HS256

# --- URL prefix ของหน้าเว็บ (root path) ---
# ว่างไว้ = เข้าที่ https://<host>:8000/ ตามปกติ
# ใส่ค่า เช่น ROOT_PATH=/securelog = ทั้งเว็บย้ายไปอยู่ใต้ https://<host>:8000/securelog/
# (เข้าที่ / จะถูก redirect ไปให้เอง) — แก้แล้วต้อง restart securelog-web
ROOT_PATH=

# ถ้ามี reverse proxy (nginx) คั่นหน้า dashboard: ใส่ IP ของ proxy ที่เชื่อได้ (คั่นด้วย ,)
# ว่าง = ไม่มี proxy (ค่าเดิม) · ถ้าไม่ใส่ทั้งที่มี proxy: login lockout กับ rate limit จะเห็นเป็น
# IP ของ proxy ทุกคน = คนเดียวใส่รหัสผิดจนโดนล็อก แล้วล็อกยกระบบ
# ใส่แล้ว systemd/_gen.sh จะเติม --proxy-headers --forwarded-allow-ips ให้ securelog-web เอง
# ควรคู่กับ WEB_BIND_HOST=127.0.0.1 เพื่อไม่ให้ใครยิงข้าม proxy เข้ามาปลอม X-Forwarded-For ได้
FORWARDED_ALLOW_IPS=

# ตั้งเป็น true เฉพาะเมื่อ proxy "ตัด" prefix ออกให้ก่อนแล้ว (nginx proxy_pass ที่ลงท้ายด้วย /)
ROOT_PATH_STRIPPED=

# --- โหมด URL สัมพัทธ์ (ย้าย prefix ที่ nginx ได้โดยไม่ต้องแตะ .env / ไม่ต้อง restart) ---
# true = หน้าเว็บใช้ URL แบบสัมพัทธ์ทั้งหมด (browser ประกอบ prefix ให้เอง) — ใช้คู่กับ proxy ที่
# ตัด prefix ออกให้แล้วเท่านั้น (nginx proxy_pass ที่ลงท้ายด้วย /) และปล่อย ROOT_PATH ว่างไว้
# ให้ nginx ส่ง prefix มาด้วย: proxy_set_header X-Forwarded-Prefix /xxx;
#   (ไม่ส่งมาก็ยังใช้งานได้ แต่ cookie จะกลับไปอยู่ที่ราก = ชนกับ service อื่นที่ชื่อ cookie ซ้ำกัน)
# ⚠️ ทุกหน้าเว็บต้องอยู่ "ชั้นเดียว" (/dashboard, /agents) — ถ้าเพิ่มหน้าแบบ /agents/{id}
# URL สัมพัทธ์ในหน้านั้นจะเพี้ยนทั้งหน้า · หน้า error ของ path ที่ลึกกว่า 1 ชั้นจะโหลด css ไม่ขึ้น
RELATIVE_URLS=

# --- ชื่อ cookie (ใช้ตอนแชร์โฮสต์+พอร์ตกับ service อื่นผ่าน nginx) ---
# ว่างไว้ = ระบบตั้งให้เอง: มี ROOT_PATH ใช้ prefix (/xxx -> access_token_xxx) · อยู่ที่รากใช้ชื่อระบบ
# (ROOT_PATH ว่าง -> access_token_securelog) จึงไม่ชนกับ service อื่นบนโฮสต์+พอร์ตเดียวกันในทุกกรณี
# ใส่ค่าเอง เช่น COOKIE_SUFFIX=prod = access_token_prod · ใส่ off/none = ใช้ชื่อเดิมล้วน ๆ
# ทำไมต้องมี: browser แยก cookie ด้วย "ชื่อ+path" แต่ตอนส่งกลับมามันส่งมาให้ทั้งใบของเราและ
# ของ service อื่นที่ชื่อซ้ำกัน แล้วฝั่ง server อ่านใบท้ายสุดชนะ = อีก service ทำเราหลุด login ได้
# ⚠️ แก้ค่านี้ (หรือแก้ ROOT_PATH) = ชื่อ cookie เปลี่ยน คนที่ล็อกอินค้างอยู่ต้องล็อกอินใหม่
COOKIE_SUFFIX=

# --- IP ที่แต่ละ service เปิดรับ (systemd/_gen.sh อ่านไปใส่ --host ของ unit) ---
# ปกติไม่ต้องกรอกเอง — sudo systemd/install.sh จะถามให้เลือกจาก interface ที่มีจริงบนเครื่อง
# แล้วเขียนค่าลงที่นี่ให้ (แก้เองก็ได้ แต่ต้องรัน install.sh ใหม่ค่าถึงจะมีผล)
#   0.0.0.0 = ทุก interface · ใส่ IP เดียว = เครือข่ายอื่นของเครื่องเข้าไม่ถึงพอร์ตนั้นเลย
# ⚠️ WEB_BIND_HOST ที่เป็น IP เดียว ต้องมี IP นั้นใน SAN ของ cert/central/dashboard.crt ด้วย
WEB_BIND_HOST=0.0.0.0
# LINE ยิง webhook เข้ามาผ่าน tunnel — tunnel อยู่เครื่องเดียวกันตั้ง 127.0.0.1 ได้ (ไม่โผล่ออกเครือข่าย)
WEBHOOK_BIND_HOST=0.0.0.0

# --- ค่าที่ฝังลงชุดติดตั้ง Client Server (site.conf ใน zip) ---
# ที่อยู่/พอร์ตที่ agent ใช้ต่อกลับมาหา central — ปกติ setup-server.sh เขียนให้เอง
# (ค่าเดียวกับที่มันเอาไปออก cert SAN และเปิด firewall) ไม่มีในไฟล์นี้ก็ตกไปใช้ REDIS_HOST/REDIS_PORT
# ⚠️ ไม่ใช่ค่าที่แก้จากหน้าเว็บ — ย้าย IP ให้รัน setup-server.sh ซ้ำ จะได้ตามแก้ cert/firewall ให้ครบ
AGENT_CENTRAL_HOST=192.168.56.110
AGENT_CENTRAL_REDIS_PORT=6380

# user/รหัส Redis ของฝั่ง agent — ที่นี่เป็นแค่ค่าตั้งต้นตอนที่ยังไม่เคยตั้งผ่านหน้า System Settings
# (ตั้งแล้วค่าจริงอยู่ในตาราง app_settings และชนะค่าในไฟล์นี้) ต้องตรงกับ redis/users.acl
AGENT_REDIS_USERNAME=agent_node
AGENT_REDIS_PASSWORD=

# --- LINE Messaging API (แจ้งเตือน alert) — เอาค่าจาก LINE Developers Console ของ channel ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Gemini (AI สรุป log ใน alert — on-demand, ไม่ตั้งก็ใช้งานส่วนอื่นได้ปกติ) ---
# เอา API key จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=
